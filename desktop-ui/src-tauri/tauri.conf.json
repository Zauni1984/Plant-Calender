{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlockSocial Plants Calendar",
  "version": "0.1.0",
  "identifier": "eu.blocksocial.plantscalendar",
  "build": {
    "beforeDevCommand": "npm run dev -- --host",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlockSocial Plants Calendar",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
